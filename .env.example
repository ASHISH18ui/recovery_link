# RecoverLink Environment Configuration

# Backend
SECRET_KEY=recoverlink-super-secret-jwt-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./recoverlink.db
# For PostgreSQL in Docker or Production:
# DATABASE_URL=postgresql://recoverlink_user:recoverlink_pass@postgres:5432/recoverlink_db

# Optional AI API Key (Gemini or OpenAI)
# If left empty, deterministic clinical rule-based engine will be used automatically
GEMINI_API_KEY=
OPENAI_API_KEY=

# Public URLs
PATIENT_PORTAL_URL=http://localhost:3000/recovery
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

