# AfterCare Backend Environment Configuration

# Security & Authentication
# Generate a secure key in production (e.g. openssl rand -hex 32)
JWT_SECRET=supersecretkey_recoverlink_development_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Leave unset or empty for SQLite (sqlite:///./recoverlink.db)
# Or provide a PostgreSQL connection URL (e.g. postgresql://user:pass@host:5432/dbname)
DATABASE_URL=

# CORS Configuration
# Comma-separated list of allowed origins (e.g. http://localhost:3000,https://your-frontend.vercel.app)
ALLOWED_ORIGINS=http://localhost:3000

# Google Gemini API
# Optional: Fallback heuristics are used if no key is provided
GEMINI_API_KEY=

# Patient Portal Base URL
PATIENT_PORTAL_URL=http://localhost:3000

